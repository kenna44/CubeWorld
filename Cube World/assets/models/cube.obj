# 2x2x2 cube centered at the origin
# 8 positions, 6 face normals, 4 UVs, 12 triangles (CCW winding from outside)

# Positions
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Face normals
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Faces (v/vt/vn)
# +Z
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1
# -Z
f 1/2/2 4/3/2 3/4/2
f 1/2/2 3/4/2 2/1/2
# +X
f 2/1/3 3/2/3 7/3/3
f 2/1/3 7/3/3 6/4/3
# -X
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4
# +Y
f 4/1/5 8/2/5 7/3/5
f 4/1/5 7/3/5 3/4/5
# -Y
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
